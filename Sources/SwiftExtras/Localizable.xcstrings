    "We will send you push notifications to keep you updated on the latest news and updates." : {
      "localizations" : {
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم آپ کو تازہ ترین خبروں اور اپ ڈیٹس سے آگاہ رکھنے کے لیے پش اطلاعات بھیجیں گے۔"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te enviaremos notificaciones push para mantenerte al tanto de las últimas noticias y novedades."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We will send you push notifications to keep you updated on the latest news and updates."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "value" : "Ми надсилатимемо вам сповіщення про новинки, щоб тримати вас в курсі останніх новин та оновлень.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti invieremo notifiche push per tenerti aggiornato sulle ultime novità."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما اعلان‌های پوش را برای اطلاع‌رسانی درباره آخرین اخبار و به‌روزرسانی‌ها برای شما ارسال خواهیم کرد."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα λαμβάνεις push ειδοποιήσεις για τις πιο πρόσφατες ειδήσεις και ενημερώσεις."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seolfaimid fógraí push chugat chun tú a choinneáil suas chun dáta ar an nuacht is déanaí."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te enviaremos notificaciones push para mantenerte al día sobre las últimas noticias y actualizaciones."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",

{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Hashed string"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras\/Swift\/String\/sdbmhash"},"variants":[{"paths":["\/documentation\/swiftextras\/swift\/string\/sdbmhash"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sdbmhash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This algorithm was created for sdbm (a public-domain reimplementation of ndbm) database library.","type":"text"},{"text":" ","type":"text"},{"text":"it was found to do well in scrambling bits, causing better distribution of the keys and fewer splits.","type":"text"},{"text":" ","type":"text"},{"text":"it also happens to be a good general hashing function with good distribution.","type":"text"},{"text":" ","type":"text"},{"text":"the actual function is hash(i) = hash(i - 1) * 65599 + str[i];","type":"text"},{"text":" ","type":"text"},{"text":"what is included below is the faster version used in gawk.","type":"text"},{"text":" ","type":"text"},{"text":"[there is even a faster, duff-device version] the magic prime constant 65599 (2^6 + 2^16 - 1)","type":"text"},{"text":" ","type":"text"},{"text":"was picked out of thin air while experimenting with many different constants.","type":"text"},{"text":" ","type":"text"},{"text":"this is one of the algorithms used in berkeley db (see sleepycat) and elsewhere.","type":"text"}],"type":"paragraph"}]}],"kind":"symbol","metadata":{"modules":[{"name":"SwiftExtras","relatedModules":["Swift"]}],"roleHeading":"Instance Property","extendedModule":"Swift","symbolKind":"property","role":"symbol","title":"sdbmhash","externalID":"s:SS11SwiftExtrasE8sdbmhashSivp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sdbmhash"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}]},"hierarchy":{"paths":[["doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras","doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras\/Swift","doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras\/Swift\/String"]]},"references":{"doc://swiftextras.SwiftExtras/documentation/SwiftExtras":{"title":"SwiftExtras","url":"\/documentation\/swiftextras","identifier":"doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras","kind":"symbol","role":"collection","type":"topic","abstract":[{"text":"Reusable Swift utilities and SwiftUI components.","type":"text"}]},"doc://swiftextras.SwiftExtras/documentation/SwiftExtras/Swift/String":{"title":"String","identifier":"doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras\/Swift\/String","url":"\/documentation\/swiftextras\/swift\/string","kind":"symbol","role":"symbol","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:SS","text":"String"}],"navigatorTitle":[{"kind":"identifier","text":"String"}]},"doc://swiftextras.SwiftExtras/documentation/SwiftExtras/Swift/String/sdbmhash":{"url":"\/documentation\/swiftextras\/swift\/string\/sdbmhash","title":"sdbmhash","role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/swiftextras.SwiftExtras\/documentation\/SwiftExtras\/Swift\/String\/sdbmhash","abstract":[{"text":"Hashed string","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sdbmhash","kind":"identifier"},{"text":": ","kind":"text"},
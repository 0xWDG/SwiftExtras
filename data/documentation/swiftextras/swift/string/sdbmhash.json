{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sdbmhash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This algorithm was created for sdbm (a public-domain reimplementation of ndbm) database library.","type":"text"},{"text":" ","type":"text"},{"text":"it was found to do well in scrambling bits, causing better distribution of the keys and fewer splits.","type":"text"},{"text":" ","type":"text"},{"text":"it also happens to be a good general hashing function with good distribution.","type":"text"},{"text":" ","type":"text"},{"text":"the actual function is hash(i) = hash(i - 1) * 65599 + str[i];","type":"text"},{"text":" ","type":"text"},{"text":"what is included below is the faster version used in gawk.","type":"text"},{"text":" ","type":"text"},{"text":"[there is even a faster, duff-device version] the magic prime constant 65599 (2^6 + 2^16 - 1)","type":"text"},{"text":" ","type":"text"},{"text":"was picked out of thin air while experimenting with many different constants.","type":"text"},{"text":" ","type":"text"},{"text":"this is one of the algorithms used in berkeley db (see sleepycat) and elsewhere.","type":"text"}],"type":"paragraph"}]}],"metadata":{"extendedModule":"Swift","symbolKind":"property","title":"sdbmhash","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sdbmhash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","roleHeading":"Instance Property","modules":[{"name":"SwiftExtras","relatedModules":["Swift"]}],"externalID":"s:SS11SwiftExtrasE8sdbmhashSivp"},"identifier":{"url":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String\/sdbmhash","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftextras\/swift\/string\/sdbmhash"]}],"kind":"symbol","abstract":[{"text":"Hashed string","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExtras\/documentation\/SwiftExtras","doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift","doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String"]]},"references":{"doc://SwiftExtras/documentation/SwiftExtras/Swift":{"identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift","type":"topic","abstract":[],"url":"\/documentation\/swiftextras\/swift","kind":"symbol","role":"collection","title":"Swift"},"doc://SwiftExtras/documentation/SwiftExtras/Swift/String/sdbmhash":{"identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String\/sdbmhash","title":"sdbmhash","kind":"symbol","abstract":[{"text":"Hashed string","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sdbmhash","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"type":"topic","url":"\/documentation\/swiftextras\/swift\/string\/sdbmhash","role":"symbol"},"doc://SwiftExtras/documentation/SwiftExtras":{"url":"\/documentation\/swiftextras","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras","abstract":[{"type":"text","text":"Reusable Swift utilities and SwiftUI components."}],"kind":"symbol","type":"topic","title":"SwiftExtras","role":"collection"},"doc://SwiftExtras/documentation/SwiftExtras/Swift/String":{"navigatorTitle":[{"kind":"identifier","text":"String"}],"url":"\/documentation\/swiftextras\/swift\/string","title":"String","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","text":"String","preciseIdentifier":"s:SS"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String","abstract":[],"type":"topic"}}}
{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Hashed string","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sdbmhash"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This algorithm was created for sdbm (a public-domain reimplementation of ndbm) database library."},{"type":"text","text":" "},{"type":"text","text":"it was found to do well in scrambling bits, causing better distribution of the keys and fewer splits."},{"type":"text","text":" "},{"type":"text","text":"it also happens to be a good general hashing function with good distribution."},{"type":"text","text":" "},{"type":"text","text":"the actual function is hash(i) = hash(i - 1) * 65599 + str[i];"},{"type":"text","text":" "},{"type":"text","text":"what is included below is the faster version used in gawk."},{"type":"text","text":" "},{"type":"text","text":"[there is even a faster, duff-device version] the magic prime constant 65599 (2^6 + 2^16 - 1)"},{"type":"text","text":" "},{"type":"text","text":"was picked out of thin air while experimenting with many different constants."},{"type":"text","text":" "},{"type":"text","text":"this is one of the algorithms used in berkeley db (see sleepycat) and elsewhere."}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/swiftextras\/swift\/string\/sdbmhash"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftExtras\/documentation\/SwiftExtras","doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift","doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String\/sdbmhash"},"metadata":{"externalID":"s:SS11SwiftExtrasE8sdbmhashSivp","extendedModule":"Swift","symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"SwiftExtras","relatedModules":["Swift"]}],"title":"sdbmhash","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sdbmhash","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"}],"role":"symbol"},"references":{"doc://SwiftExtras/documentation/SwiftExtras/Swift/String":{"url":"\/documentation\/swiftextras\/swift\/string","kind":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"identifier"}],"identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String","abstract":[{"type":"text","text":"Adds case and locale-aware containment checks to "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}],"role":"symbol","title":"String","navigatorTitle":[{"text":"String","kind":"identifier"}],"type":"topic"},"doc://SwiftExtras/documentation/SwiftExtras/Swift":{"title":"Swift","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift","type":"topic","kind":"symbol","url":"\/documentation\/swiftextras\/swift","role":"collection","abstract":[]},"doc://SwiftExtras/documentation/SwiftExtras":{"abstract":[{"text":"Reusable Swift utilities and SwiftUI components.","type":"text"}],"title":"SwiftExtras","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras","url":"\/documentation\/swiftextras","kind":"symbol","role":"collection","type":"topic"},"doc://SwiftExtras/documentation/SwiftExtras/Swift/String/sdbmhash":{"role":"symbol","kind":"symbol","abstract":[{"text":"Hashed string","type":"text"}],"title":"sdbmhash","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/String\/sdbmhash","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sdbmhash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"type":"topic","url":"\/documentation\/swiftextras\/swift\/string\/sdbmhash"}}}
"},{"text":" ","type":"text"},{"text":"range simply result in ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", allowing for more graceful handling of such cases.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example usage:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["let numbers = [1, 2, 3, 4, 5]","if let number = numbers[safe: 3] {","    print(number) \/\/ Prints \"4\"","} else {","    print(\"Index out of bounds\")","}","","if let outOfBoundsNumber = numbers[safe: 10] {","    print(outOfBoundsNumber)","} else {","    print(\"Index out of bounds\") \/\/ Prints \"Index out of bounds\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method enhances the safety and readability of collection access, "},{"type":"text","text":"\n"},{"type":"text","text":"especially in more complex logic where bounds checks are necessary."}]}]}],"references":{"doc://SwiftExtras/documentation/SwiftExtras/Swift/Collection":{"navigatorTitle":[{"kind":"identifier","text":"Collection"}],"abstract":[{"text":"Adds ","type":"text"},{"code":"Collection safeIndex","type":"codeVoice"},{"text":" functionality to ","type":"text"},{"code":"Collection","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift\/Collection","url":"\/documentation\/swiftextras\/swift\/collection","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"preciseIdentifier":"s:Sl","kind":"identifier","text":"Collection"}],"type":"topic","kind":"symbol","title":"Collection","role":"symbol"},"doc://SwiftExtras/documentation/SwiftExtras/Swift":{"title":"Swift","url":"\/documentation\/swiftextras\/swift","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Swift","type":"topic"},"doc://SwiftExtras/documentation/SwiftExtras":{"title":"SwiftExtras","role":"collection","url":"\/documentation\/swiftextras","kind":"symbol","
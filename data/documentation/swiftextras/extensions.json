{"primaryContentSections":[{"content":[{"level":2,"text":"Standard Library and Foundation","type":"heading","anchor":"Standard-Library-and-Foundation"},{"inlineContent":[{"type":"text","text":"Collection and numeric extensions provide safe indexing, aggregate values,"},{"type":"text","text":" "},{"type":"text","text":"formatting, clamping, and unit conversion. "},{"type":"codeVoice","code":"Optional"},{"type":"text","text":" utilities distinguish an"},{"type":"text","text":" "},{"type":"text","text":"absent collection from a populated value, while "},{"type":"codeVoice","code":"Sequence"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Collection"},{"type":"text","text":" "},{"type":"text","text":"helpers avoid repeated boilerplate for sums and averages."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"StringProtocol"},{"type":"text","text":", and "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":" extensions cover text"},{"type":"text","text":" "},{"type":"text","text":"cleanup, slicing, quoting, Base64 encoding, URL creation, fuzzy matching, ANSI"},{"type":"text","text":" "},{"type":"text","text":"formatting, and localization. These APIs retain Swift’s character-safe string"},{"type":"text","text":" "},{"type":"text","text":"semantics; methods that can fail return an optional rather than silently"},{"type":"text","text":" "},{"type":"text","text":"inventing a result."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"Data"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URL"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Locale"},{"text":", ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ProcessInfo"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"Notification.Name"},{"text":" extensions provide platform-aware","type":"text"},{"text":" ","type":"text"},{"text":"utilities for serialization, relative time, reachability, persistence, and","type":"text"},{"text":" ","type":"text"},{"text":"runtime context. Check each symbol’s availability and failure behavior before","type":"text"},{"text":" ","type":"text"},{"text":"using it with external input or network resources.","type":"text"}],"type":"paragraph"},{"level":2,"text":"SwiftUI","type":"heading","anchor":"SwiftUI"},{"inlineContent":[{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions supply composition helpers, view-size and scroll-position"},{"type":"text","text":" "},{"type":"text","text":"readers, asynchronous tasks, change observation, error presentation, layout"},{"type":"text","text":" "},{"type":"text","text":"adaptation, snapshots, onboarding, and accessibility-preserving effects."},{"type":"text","text":" "},{"type":"text","text":"Apply them close to the view they modify so state ownership and modifier order"},{"type":"text","text":" "},{"type":"text","text":"remain clear."}],"type":"paragraph"},{"inlineContent":[{"code":"Binding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Color","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" extensions make common SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"work declarative. Bindings retain their original source of truth; image and","type":"text"},{"text":" ","type":"text"},{"text":"color helpers may be platform- or actor-constrained; and task helpers respect","type":"text"},{"text":" ","type":"text"},{"text":"Swift concurrency cancellation whenever the underlying API supports it.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Platform Integration","type":"heading","anchor":"Platform-Integration"},{"inlineContent":[{"type":"codeVoice","code":"PlatformImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"PlatformViewRepresentable"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSImage"},{"type":"text","text":", "},{"type":"codeVoice","code":"NSPasteboard"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIDevice"},{"type":"text","text":" extensions isolate UIKit and AppKit differences behind the"},{"type":"text","text":" "},{"type":"text","text":"cross-platform types exposed by SwiftExtras. Use the platform-neutral API when"},{"type":"text","text":" "},{"type":"text","text":"possible, and guard platform-specific behavior with the documented availability"},{"type":"text","text":" "},{"type":"text","text":"requirements."}],"type":"paragraph"},{"level":2,"text":"Protocol Conformances","type":"heading","anchor":"Protocol-Conformances"},{"inlineContent":[{"type":"text","text":"Some extensions add retroactive conformances, including support for"},{"type":"text","text":" "},{"type":"text","text":"identification, coding, raw values, localized errors, and sendability. These"},{"type":"text","text":" "},{"type":"text","text":"conformances are documented beside their declarations. Review their identity"},{"type":"text","text":" "},{"type":"text","text":"and serialization semantics before relying on them for persistent data or"},{"type":"text","text":" "},{"type":"text","text":"collection identity."}],"type":"paragraph"},{"level":2,"text":"Related Documentation","type":"heading","anchor":"Related-Documentation"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/StringUtilities","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/FoundationUtilities","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/CustomViews"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Extensions-and-Functions","title":"Extensions and Functions","generated":true,"identifiers":["doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Functions"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftextras\/extensions"]}],"abstract":[{"text":"SwiftExtras extends standard-library, Foundation, SwiftUI, UIKit, and AppKit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"types with focused APIs. Every extension and function declaration has DocC"},{"type":"text","text":" "},{"type":"text","text":"comments in source; use this article to choose the appropriate family before"},{"type":"text","text":" "},{"type":"text","text":"opening a symbol’s reference page."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Extensions"},"hierarchy":{"paths":[["doc:\/\/SwiftExtras\/documentation\/SwiftExtras"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Extensions","modules":[{"name":"SwiftExtras"}]},"references":{"doc://SwiftExtras/documentation/SwiftExtras/Functions":{"role":"article","abstract":[{"type":"text","text":"SwiftExtras exposes standalone functions for work that does not naturally"},{"type":"text","text":" "},{"type":"text","text":"belong to a type. Their DocC comments define their inputs, outputs, failure"},{"type":"text","text":" "},{"type":"text","text":"behavior, platform availability, and side effects."}],"title":"Functions","type":"topic","kind":"article","url":"\/documentation\/swiftextras\/functions","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/Functions"},"doc://SwiftExtras/documentation/SwiftExtras/FoundationUtilities":{"url":"\/documentation\/swiftextras\/foundationutilities","role":"collectionGroup","kind":"article","title":"Foundation Utilities","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/FoundationUtilities","type":"topic","abstract":[{"text":"Inspect the current application and display dates relative to another moment.","type":"text"}]},"doc://SwiftExtras/documentation/SwiftExtras/StringUtilities":{"title":"String Utilities","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/StringUtilities","abstract":[{"text":"Format and divide strings with small convenience APIs.","type":"text"}],"role":"collectionGroup","kind":"article","type":"topic","url":"\/documentation\/swiftextras\/stringutilities"},"doc://SwiftExtras/documentation/SwiftExtras/CustomViews":{"title":"Custom Views","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras\/CustomViews","abstract":[{"text":"Use these compact iOS examples as a visual reference for the SwiftExtras SwiftUI views and layouts.","type":"text"}],"role":"article","kind":"article","url":"\/documentation\/swiftextras\/customviews","type":"topic"},"doc://SwiftExtras/documentation/SwiftExtras":{"abstract":[{"text":"Reusable Swift utilities and SwiftUI components.","type":"text"}],"title":"SwiftExtras","identifier":"doc:\/\/SwiftExtras\/documentation\/SwiftExtras","url":"\/documentation\/swiftextras","kind":"symbol","role":"collection","type":"topic"}}}
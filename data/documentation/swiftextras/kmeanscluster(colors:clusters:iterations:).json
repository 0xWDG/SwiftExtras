"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This function takes an array of colors and clusters them into a specified number of groups."},{"type":"text","text":" "},{"type":"text","text":"It uses the K-Means algorithm to find the centroids of the clusters."},{"type":"text","text":" "},{"type":"text","text":"The algorithm iteratively assigns colors to the nearest centroid and then recalculates the centroids"},{"type":"text","text":" "},{"type":"text","text":"based on the assigned colors."},{"type":"text","text":" "},{"type":"text","text":"The process is repeated for a specified number of iterations."},{"type":"text","text":" "},{"type":"text","text":"The centroids are returned as an array of colors."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This implementation uses the Euclidean distance in RGB space to determine the distance between colors.","type":"text"}]}]}],"kind":"content"}],"metadata":{"title":"kMeansCluster(colors:clusters:iterations:)","roleHeading":"Function","role":"symbol","modules":[{"name":"SwiftExtras"}],"symbolKind":"func","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"kMeansCluster","kind":"identifier"},{"text":"(","kind":"text"},{"text":"colors","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"Color","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI5ColorV"},{"text":"], ","kind":"text"},{"text":"clusters","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"iterations"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> ["},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI5ColorV","text":"Color"},{"kind":"text","text":"]"}],"externalID":"s:11SwiftExt